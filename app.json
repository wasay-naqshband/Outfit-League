{
  "expo": {
    "name": "Outfit League",
    "slug": "outfit-league",
    "scheme": "outfitleague",
    "version": "0.1.0",
    "icon": "./assets/branding/outfit-league-logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "bundleIdentifier": "com.outfitleague.app"
    },
    "android": {
      "package": "com.outfitleague.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Outfit League",
      "favicon": "./assets/branding/outfit-league-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBEA",
          "image": "./assets/branding/outfit-league-logo.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.outfitleague.app",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "image/*"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose your own photos for private outfit previews.",
          "cameraPermission": "Take a photo for your private outfit preview.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-localization",
      "./plugins/without-push-entitlement"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "com.outfitleague.app.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.outfitleague.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "9815ed89-c0d6-45eb-aec9-b4c8e3c2a7c2"
      }
    },
    "owner": "wasaynaqshband"
  }
}
