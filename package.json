{
  "name": "outfit-league",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web && node scripts/flatten-web-assets.cjs dist && node -e \"require('node:fs').copyFileSync('public/_routes.json', 'dist/_routes.json')\"",
    "deploy:cloudflare": "pnpm export:web && pnpm dlx wrangler@4 pages deploy dist --project-name outfit-league --branch main",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"supabase/functions/**/*.ts\" \"tests/*.ts\" \"scripts/*.cjs\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"supabase/functions/**/*.ts\" \"tests/*.ts\" \"scripts/*.cjs\"",
    "preview": "node scripts/preview.cjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:server": "deno check supabase/functions/tryon/index.ts supabase/functions/battles/index.ts supabase/functions/shopping/index.ts supabase/functions/account/index.ts supabase/functions/revenuecat-webhook/index.ts",
    "verify:supabase": "node scripts/verify-supabase.cjs",
    "test:hosted": "node scripts/test-hosted.cjs",
    "test:library:hosted": "node scripts/test-library-hosted.cjs",
    "test:explore:hosted": "node scripts/test-explore-hosted.cjs",
    "test:battles:hosted": "node scripts/test-battles-hosted.cjs",
    "test:shopping:hosted": "node scripts/test-shopping-hosted.cjs",
    "test:account:hosted": "node scripts/test-account-hosted.cjs",
    "test:images": "deno test tests/result-image.deno.ts"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-query": "^5.104.4",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-application": "~58.1.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.1.0",
    "posthog-react-native": "^4.83.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "^10.15.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/react": "~19.3.3",
    "deno": "^2.9.6",
    "fast-png": "6.4.0",
    "jpeg-js": "0.4.4",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.25.0"
}
