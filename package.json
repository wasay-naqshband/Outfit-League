{
  "name": "outfit-league",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web && node scripts/flatten-web-assets.cjs dist",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"supabase/functions/**/*.ts\" \"tests/*.ts\" \"scripts/*.cjs\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"supabase/functions/**/*.ts\" \"tests/*.ts\" \"scripts/*.cjs\"",
    "preview": "node scripts/preview.cjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:server": "deno check supabase/functions/tryon/index.ts supabase/functions/battles/index.ts supabase/functions/shopping/index.ts supabase/functions/account/index.ts supabase/functions/revenuecat-webhook/index.ts",
    "verify:supabase": "node scripts/verify-supabase.cjs",
    "test:hosted": "node scripts/test-hosted.cjs",
    "test:library:hosted": "node scripts/test-library-hosted.cjs",
    "test:explore:hosted": "node scripts/test-explore-hosted.cjs",
    "test:battles:hosted": "node scripts/test-battles-hosted.cjs",
    "test:shopping:hosted": "node scripts/test-shopping-hosted.cjs",
    "test:account:hosted": "node scripts/test-account-hosted.cjs",
    "test:images": "deno test tests/result-image.deno.ts"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-query": "^5.104.4",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~55.0.31",
    "expo-apple-authentication": "~55.0.17",
    "expo-application": "~55.0.19",
    "expo-clipboard": "~55.0.0",
    "expo-constants": "~55.0.0",
    "expo-crypto": "~55.0.19",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.0",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.0",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.0",
    "expo-linking": "~55.0.0",
    "expo-localization": "~55.0.19",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.0",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.0",
    "expo-status-bar": "~55.0.0",
    "expo-video": "~55.0.21",
    "expo-web-browser": "~55.0.20",
    "posthog-react-native": "^4.83.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-purchases": "^10.15.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/react": "~19.2.0",
    "deno": "^2.9.6",
    "fast-png": "6.4.0",
    "jpeg-js": "0.4.4",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@11.25.0"
}
